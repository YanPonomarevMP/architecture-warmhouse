{
    "openapi": "3.1.0",
    "info": {
        "title": "FastAPI",
        "version": "0.1.0"
    },
    "paths": {
        "/devices/{id_or_slug}/monitor": {
            "get": {
                "summary": "Мониторинг устройства по его ID",
                "operationId": "devices_get_device_monitor_by_id_devices__id_or_slug__monitor_get",
                "parameters": [
                    {
                        "name": "id_or_slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Id Or Slug"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MonitorResponses"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/devices/": {
            "post": {
                "summary": "Создание нового устройства",
                "operationId": "devices_create_device_devices__post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DeviceBody"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Device"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/devices/{id_or_slug}": {
            "delete": {
                "summary": "Удаление устройства",
                "operationId": "devices_delete_device_devices__id_or_slug__delete",
                "parameters": [
                    {
                        "name": "id_or_slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Id Or Slug"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Device"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/devices/{id_or_slug}/status": {
            "put": {
                "summary": "Включение и выключение устройства",
                "operationId": "devices_turn_off_device_devices__id_or_slug__status_put",
                "parameters": [
                    {
                        "name": "id_or_slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Id Or Slug"
                        }
                    },
                    {
                        "name": "status_body",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/StatusBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Device"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/temperature": {
            "get": {
                "summary": "Рандомное значение температуры",
                "operationId": "devices_get_temperature_by_location_temperature_get",
                "parameters": [
                    {
                        "name": "location",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Location"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TemperatureResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Device": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "type": {
                        "$ref": "#/components/schemas/DeviceType"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "type"
                ],
                "title": "Device"
            },
            "DeviceBody": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "type": {
                        "$ref": "#/components/schemas/DeviceType"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "type"
                ],
                "title": "DeviceBody"
            },
            "DeviceType": {
                "type": "string",
                "enum": [
                    "temperature",
                    "gate",
                    "lighting"
                ],
                "title": "DeviceType"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "MonitorResponses": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "data": {
                        "$ref": "#/components/schemas/TemperatureData"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "data"
                ],
                "title": "MonitorResponses"
            },
            "StatusBody": {
                "type": "string",
                "enum": [
                    "turn_on",
                    "turn_off"
                ],
                "title": "StatusBody"
            },
            "TemperatureData": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "ip_address": {
                        "type": "string",
                        "title": "Ip Address"
                    },
                    "timestamp": {
                        "type": "integer",
                        "title": "Timestamp"
                    },
                    "temperature": {
                        "type": "string",
                        "title": "Temperature"
                    },
                    "unit_of_measurement": {
                        "$ref": "#/components/schemas/UnitOfMeasurement"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "ip_address",
                    "timestamp",
                    "temperature",
                    "unit_of_measurement"
                ],
                "title": "TemperatureData"
            },
            "TemperatureResponse": {
                "properties": {
                    "temperature": {
                        "type": "integer",
                        "title": "Temperature"
                    }
                },
                "type": "object",
                "required": [
                    "temperature"
                ],
                "title": "TemperatureResponse"
            },
            "UnitOfMeasurement": {
                "type": "string",
                "enum": [
                    "fahrenheit",
                    "celsius"
                ],
                "title": "UnitOfMeasurement"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}